@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<section class="tl-section">
    <div class="container">
        <h1 class="tl-h2">Something went wrong</h1>
        <p class="text-body-secondary">The problem has been logged. Please try again in a moment.</p>
        @if (Model.ShowRequestId)
        {
            <p class="small text-body-secondary">Reference: <code>@Model.RequestId</code></p>
        }
        <a class="btn btn-tl" asp-page="/Index">Back to the home page</a>
    </div>
</section>
